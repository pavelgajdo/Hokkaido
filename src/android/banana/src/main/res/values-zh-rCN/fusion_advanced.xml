    <string name="fusion_adv_dm_oot_lod_scale_default" formatted="false">完整距离（游戏默认）</string>
    <string name="fusion_adv_dm_oot_lod_scale_warn" formatted="false">远处的人物、建筑和物件会更简单，走近时外观可能发生变化。</string>
