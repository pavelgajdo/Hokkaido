    <string name="fusion_adv_dm_oot_draw_distance_default" formatted="false">完整距离（游戏默认）</string>
    <string name="fusion_adv_dm_oot_draw_distance_warn" formatted="false">远景会被截断，并随行走逐渐出现；原野的地平线会较空旷。</string>
    <string name="fusion_adv_dm_oot_draw_distance_option_0" formatted="false">远（300）</string>
