    <string name="fusion_adv_dm_vk_skip_warn_try_if" formatted="false">the notice \"Part of the picture is not drawn\" appears and you want it off (0) or only for larger gaps</string>
    <string name="fusion_adv_dm_vk_skip_warn_default" formatted="false">5 %</string>
    <string name="fusion_adv_dm_vk_tex_soft_label" formatted="false">Soft textures</string>
    <string name="fusion_adv_dm_vk_tex_soft_try_if" formatted="false">the game runs out of memory; large textures lose their finest level and look a little softer</string>
    <string name="fusion_adv_dm_vk_tex_soft_default" formatted="false">The game\'s profile decides</string>
    <string name="fusion_adv_dm_vk_tex_soft_warn" formatted="false">Textures look slightly softer. Not measured on every game.</string>
    <string name="fusion_adv_dm_vk_tex_soft_option_0" formatted="false">Off</string>
    <string name="fusion_adv_dm_vk_tex_soft_option_1" formatted="false">On</string>
    <string name="fusion_adv_dm_vk_tex_soft_levels_label" formatted="false">Soft texture levels</string>
    <string name="fusion_adv_dm_vk_tex_soft_levels_try_if" formatted="false">the game still runs out of memory with Soft textures on (more levels save more, textures get softer)</string>
    <string name="fusion_adv_dm_vk_tex_soft_levels_default" formatted="false">1 level</string>
    <string name="fusion_adv_dm_vk_tex_soft_levels_warn" formatted="false">Textures look softer with more levels.</string>
    <string name="fusion_adv_dm_vk_tex_soft_levels_option_0" formatted="false">1 level</string>
    <string name="fusion_adv_dm_vk_tex_soft_levels_option_1" formatted="false">2 levels</string>
