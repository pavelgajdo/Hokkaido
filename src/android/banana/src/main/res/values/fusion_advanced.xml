    <string name="fusion_adv_dm_oot_draw_distance_label" formatted="false">Draw distance</string>
    <string name="fusion_adv_dm_oot_draw_distance_try_if" formatted="false">the game is slow in a field or town (a shorter distance draws less)</string>
    <string name="fusion_adv_dm_oot_draw_distance_default" formatted="false">Full (the game\'s own)</string>
    <string name="fusion_adv_dm_oot_draw_distance_warn" formatted="false">Far scenery is cut off and appears as you walk; fields show a plain horizon.</string>
    <string name="fusion_adv_dm_oot_draw_distance_option_0" formatted="false">Long (300)</string>
    <string name="fusion_adv_dm_oot_draw_distance_option_1" formatted="false">Medium (150)</string>
    <string name="fusion_adv_dm_oot_draw_distance_option_2" formatted="false">Short (80)</string>
    <string name="fusion_adv_dm_oot_draw_distance_option_3" formatted="false">Very short (40)</string>
    <string name="fusion_adv_dm_oot_fog_at_cut_label" formatted="false">Fog at the cut</string>
    <string name="fusion_adv_dm_oot_fog_at_cut_try_if" formatted="false">a short Draw distance leaves a hard horizon where scenery is cut off (haze hides it)</string>
    <string name="fusion_adv_dm_oot_fog_at_cut_default" formatted="false">Off (the game\'s own fog)</string>
    <string name="fusion_adv_dm_oot_fog_at_cut_warn" formatted="false">Works only with a Draw distance set. Far scenery fades into haze; Medium and Strong make distant hills bluish and also fog reflections.</string>
    <string name="fusion_adv_dm_oot_fog_at_cut_option_0" formatted="false">Light</string>
    <string name="fusion_adv_dm_oot_fog_at_cut_option_1" formatted="false">Medium</string>
    <string name="fusion_adv_dm_oot_fog_at_cut_option_2" formatted="false">Strong</string>
    <string name="fusion_adv_dm_oot_foliage_distance_label" formatted="false">Foliage distance</string>
    <string name="fusion_adv_dm_oot_foliage_distance_try_if" formatted="false">the game is slow where there is grass, bushes or trees (a shorter distance draws less of them)</string>
    <string name="fusion_adv_dm_oot_foliage_distance_default" formatted="false">Full (the game\'s own)</string>
    <string name="fusion_adv_dm_oot_foliage_distance_warn" formatted="false">Grass, bushes and small trees end nearer and appear as you walk.</string>
    <string name="fusion_adv_dm_oot_foliage_distance_option_0" formatted="false">Long (75%)</string>
    <string name="fusion_adv_dm_oot_foliage_distance_option_1" formatted="false">Medium (50%)</string>
    <string name="fusion_adv_dm_oot_foliage_distance_option_2" formatted="false">Short (35%)</string>
    <string name="fusion_adv_dm_oot_lod_scale_label" formatted="false">Model detail distance</string>
    <string name="fusion_adv_dm_oot_lod_scale_try_if" formatted="false">the game is slow in a town or field (models switch to simpler versions nearer)</string>
    <string name="fusion_adv_dm_oot_lod_scale_default" formatted="false">Full (the game\'s own)</string>
    <string name="fusion_adv_dm_oot_lod_scale_warn" formatted="false">Distant people, buildings and props look simpler and may change as you walk closer.</string>
    <string name="fusion_adv_dm_oot_lod_scale_option_0" formatted="false">A little nearer (0.75)</string>
    <string name="fusion_adv_dm_oot_lod_scale_option_1" formatted="false">Nearer (0.5)</string>
    <string name="fusion_adv_dm_oot_lod_scale_option_2" formatted="false">Much nearer (0.3)</string>
    <string name="fusion_adv_dm_oot_shadow_range_label" formatted="false">Shadow range</string>
    <string name="fusion_adv_dm_oot_shadow_range_try_if" formatted="false">the game is slow in a field or town (a shorter range draws fewer shadow casters)</string>
    <string name="fusion_adv_dm_oot_shadow_range_default" formatted="false">Full (the game\'s own)</string>
    <string name="fusion_adv_dm_oot_shadow_range_warn" formatted="false">Shadows end nearer to Link; at Short and Very short distant shadows stop at a line.</string>
    <string name="fusion_adv_dm_oot_shadow_range_option_0" formatted="false">Long (500)</string>
    <string name="fusion_adv_dm_oot_shadow_range_option_1" formatted="false">Medium (200)</string>
    <string name="fusion_adv_dm_oot_shadow_range_option_2" formatted="false">Short (100)</string>
    <string name="fusion_adv_dm_oot_shadow_range_option_3" formatted="false">Very short (50)</string>
