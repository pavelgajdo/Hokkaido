    <string name="fusion_adv_dm_vk_img_psi_try_if" formatted="false">textures reload and stutter although the phone has free memory (Off gives the older behaviour)</string>
    <string name="fusion_adv_dm_vk_img_psi_default" formatted="false">On: the texture cache shrinks when Android stalls on memory</string>
    <string name="fusion_adv_dm_vk_img_psi_option_0" formatted="false">Off</string>
    <string name="fusion_adv_dm_vk_img_psi_option_1" formatted="false">On</string>
