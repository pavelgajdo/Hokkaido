    <string name="fusion_adv_dm_vk_mesh_prepass_skip_try_if" formatted="false">the picture shows spikes or flicker on models (it is a workaround for Qualcomm\'s driver)</string>
    <string name="fusion_adv_dm_vk_mesh_prepass_skip_default" formatted="false">On with Qualcomm\'s driver when its mesh shaders are on, else off</string>
    <string name="fusion_adv_dm_vk_mesh_prepass_skip_option_0" formatted="false">Off</string>
    <string name="fusion_adv_dm_vk_mesh_prepass_skip_option_1" formatted="false">On</string>
