<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="fusion_fx_amdboost_scalefactor_label">縮放倍數</string>
    <string name="fusion_fx_amdboost_scalefactor_tooltip">超解析度倍數（1.0 為原始尺寸，1.5 為 1.5 倍，2.0 為 2 倍）。數值越大，效能開銷越高。</string>
    <string name="fusion_fx_amdboost_sharpness_label">銳度</string>
    <string name="fusion_fx_amdboost_sharpness_tooltip">RCAS 銳化強度。數值越大，邊緣對比越強。</string>
    <string name="fusion_fx_amdboost_enabledenoise_label">啟用降噪</string>
    <string name="fusion_fx_amdboost_enabledenoise_tooltip">在超解析度前進行輕度降噪，減少畫面瑕疵。</string>
    <string name="fusion_fx_amdboost_denoisestrength_label">降噪強度</string>
    <string name="fusion_fx_amdboost_denoisestrength_tooltip">降噪濾鏡的強度，僅在啟用降噪時生效。</string>
    <string name="fusion_fx_amdboost_enableupscaling_label">啟用超解析度</string>
    <string name="fusion_fx_amdboost_enableupscaling_tooltip">啟用 FSR 1 EASU 超解析度；關閉後僅進行銳化。</string>
    <string name="fusion_fx_amdboost_amdboost_label">AMD 增強</string>
    <string name="fusion_fx_amdboost_amdboost_tooltip">AMD FidelityFX 增強：結合 FSR 1 超解析度（EASU）、RCAS 銳化和可選降噪，改善畫質。</string>
    <string name="fusion_fx_bloom_radius_label">半徑</string>
    <string name="fusion_fx_bloom_radius_tooltip">光暈從明亮區域向外擴散的範圍。</string>
    <string name="fusion_fx_bloom_amount_label">強度</string>
    <string name="fusion_fx_bloom_amount_tooltip">疊加到畫面上的光暈強度。</string>
    <string name="fusion_fx_bloom_bloom_label">泛光</string>
    <string name="fusion_fx_bloom_bloom_tooltip">讓最亮的區域向外擴散出柔和光暈，模擬相機拍攝強光時的效果。</string>
    <string name="fusion_fx_blur_radius_tooltip">模糊擴散的距離，單位為畫素。</string>
    <string name="fusion_fx_blur_strength_label">強度</string>
    <string name="fusion_fx_blur_strength_tooltip">原始畫面與模糊畫面的混合程度。</string>
    <string name="fusion_fx_blur_focussize_label">中心清晰區域</string>
    <string name="fusion_fx_blur_focussize_tooltip">螢幕中心保持清晰的範圍。設為零時，整個畫面均勻模糊。</string>
    <string name="fusion_fx_blur_focussoftness_label">焦點過渡</string>
    <string name="fusion_fx_blur_focussoftness_tooltip">中心清晰區域向周圍模糊區域過渡的柔和程度。</string>
    <string name="fusion_fx_blur_blur_label">模糊</string>
    <string name="fusion_fx_blur_blur_tooltip">高斯模糊，可讓中心保持清晰，用於柔化畫面或模擬景深。</string>
    <string name="fusion_fx_crt_density_label">掃描線密度</string>
    <string name="fusion_fx_crt_rollspeed_label">滾動速度</string>
    <string name="fusion_fx_crt_rollspeed_tooltip">滾動條帶的速度，設為零可關閉。</string>
    <string name="fusion_fx_crt_bleed_label">色彩滲出</string>
    <string name="fusion_fx_crt_bleed_tooltip">紅色和綠色通道在水平方向上的分離距離。</string>
    <string name="fusion_fx_crt_crt_label">映像管電視</string>
    <string name="fusion_fx_crt_crt_tooltip">模擬映像管電視的彎曲掃描線與螢光點陣，適合原本為此類螢幕設計的遊戲。</string>
    <string name="fusion_fx_cartoon_edgestrength_label">邊緣強度</string>
    <string name="fusion_fx_cartoon_edgestrength_tooltip">偵測到的邊緣周圍墨線的深淺。</string>
    <string name="fusion_fx_cartoon_levels_label">色彩層級</string>
    <string name="fusion_fx_cartoon_levels_tooltip">將顏色量化為多少個層級。</string>
    <string name="fusion_fx_cartoon_cartoon_label">卡通</string>
    <string name="fusion_fx_cartoon_cartoon_tooltip">加入墨線輪廓和平坦色塊。忠實移植自 PPSSPP；暗處輪廓較重，若陰影糊成黑塊，可嘗試柔和卡通或賽璐璐著色。</string>
    <string name="fusion_fx_cartoonsoft_shadowguard_label">陰影保護</string>
    <string name="fusion_fx_cartoonsoft_shadowguard_tooltip">減弱暗處的輪廓。陰影變成黑塊時可調高。</string>
    <string name="fusion_fx_cartoonsoft_smoothing_label">色階化</string>
    <string name="fusion_fx_cartoonsoft_smoothing_tooltip">將畫面轉為平坦色塊的程度。</string>
    <string name="fusion_fx_cartoonsoft_saturation_label">飽和度</string>
    <string name="fusion_fx_cartoonsoft_cartoonsoft_label">柔和卡通</string>
    <string name="fusion_fx_cartoonsoft_cartoonsoft_tooltip">加入墨線輪廓和平坦色塊，同時減弱陰影中的輪廓，避免暗處糊成黑塊。</string>
    <string name="fusion_fx_celshading_bands_label">明暗層級</string>
    <string name="fusion_fx_celshading_bands_tooltip">將光照壓縮為多少個平坦層級。三至四級可形成經典卡通效果。</string>
    <string name="fusion_fx_celshading_bandcontrast_label">色階對比</string>
    <string name="fusion_fx_celshading_bandcontrast_tooltip">讓明暗層級更接近純黑和純白。陰影細節丟失時可調低。</string>
    <string name="fusion_fx_celshading_bandedge_label">色階邊界</string>
    <string name="fusion_fx_celshading_bandedge_tooltip">相鄰明暗層級之間的過渡寬度。數值越小，賽璐璐分層越明顯。</string>
    <string name="fusion_fx_celshading_detail_label">紋理細節</string>
    <string name="fusion_fx_celshading_detail_tooltip">平面化後保留的表面紋理細節。設為零時，色塊完全平坦。</string>
    <string name="fusion_fx_celshading_outlinestrength_label">輪廓強度</string>
    <string name="fusion_fx_celshading_outlinestrength_tooltip">沿偵測邊緣繪製的墨線不透明度。</string>
    <string name="fusion_fx_celshading_outlinethreshold_label">輪廓閾值</string>
    <string name="fusion_fx_celshading_outlinethreshold_tooltip">邊緣達到多強才會描線。調高可減少紋理和鏡面高光上的墨線。</string>
    <string name="fusion_fx_celshading_saturation_tooltip">平坦色塊區域的色彩濃度。</string>
    <string name="fusion_fx_celshading_celshading_label">賽璐璐著色</string>
    <string name="fusion_fx_celshading_celshading_tooltip">將光照壓縮為少量清晰層級並描繪邊緣，同時保留紋理細節和色相。</string>
    <string name="fusion_fx_chromaticaberration_strength_tooltip">螢幕邊緣處的顏色通道分離距離，單位為畫素。</string>
    <string name="fusion_fx_chromaticaberration_falloff_label">衰減</string>
    <string name="fusion_fx_chromaticaberration_falloff_tooltip">離開中心後通道分離增加的速度。數值越大，中心區域越乾淨。</string>
    <string name="fusion_fx_chromaticaberration_chromaticaberration_label">色差</string>
    <string name="fusion_fx_chromaticaberration_chromaticaberration_tooltip">讓顏色通道越靠近螢幕邊緣越分離，模擬鏡頭無法將所有顏色聚焦到同一點的現象。</string>
    <string name="fusion_fx_colorgrade_brightness_label">亮度</string>
    <string name="fusion_fx_colorgrade_contrast_label">對比度</string>
    <string name="fusion_fx_colorgrade_gamma_label">伽馬</string>
    <string name="fusion_fx_colorgrade_colorgrade_label">基礎調色</string>
    <string name="fusion_fx_colorgrade_colorgrade_tooltip">一次處理飽和度、亮度、對比度和伽馬這四項基本色彩參數，可先從這裡調整畫面。</string>
    <string name="fusion_fx_deband_threshold_label">閾值</string>
    <string name="fusion_fx_deband_threshold_tooltip">周圍區域多平坦才會被平滑處理。調高可消除更明顯的色帶，調低可保留更多細節。</string>
    <string name="fusion_fx_deband_radius_tooltip">取樣範圍，單位為畫素。更寬的漸變需要更大的半徑。</string>
    <string name="fusion_fx_deband_grain_label">抖動</string>
    <string name="fusion_fx_deband_grain_tooltip">平滑後加入少量噪點，打散殘餘色帶。</string>
    <string name="fusion_fx_deband_deband_label">去色帶</string>
    <string name="fusion_fx_deband_deband_tooltip">平滑天空等漸變中的明顯分層，再用抖動消除殘餘色帶。大面積平坦區域出現圈狀色階時可使用。</string>
    <string name="fusion_fx_denoise_curve_label">陰影偏置</string>
    <string name="fusion_fx_denoise_denoise_label">降噪</string>
    <string name="fusion_fx_denoise_denoise_tooltip">保留邊緣的模糊處理，消除抖動和壓縮噪點，同時保持輪廓清晰。移植自 Anime4K。</string>
    <string name="fusion_fx_filmgrain_intensity_label">強度</string>
    <string name="fusion_fx_filmgrain_size_label">大小</string>
    <string name="fusion_fx_filmgrain_size_tooltip">底片顆粒的大小，單位為畫素。</string>
    <string name="fusion_fx_filmgrain_colored_label">彩色程度</string>
    <string name="fusion_fx_filmgrain_colored_tooltip">設為零時為單色顆粒，設為一時各顏色通道分別生成噪點。</string>
    <string name="fusion_fx_filmgrain_filmgrain_label">底片顆粒</string>
    <string name="fusion_fx_filmgrain_filmgrain_tooltip">加入攝影底片顆粒，中間調最明顯，黑色和白色區域逐漸減弱。</string>
    <string name="fusion_fx_filmiccurve_exposure_label">曝光</string>
    <string name="fusion_fx_filmiccurve_toe_label">暗部曲線</string>
    <string name="fusion_fx_filmiccurve_toe_tooltip">大於 1.0 時加深陰影，小於 1.0 時提亮陰影。</string>
    <string name="fusion_fx_filmiccurve_shoulder_label">亮部曲線</string>
    <string name="fusion_fx_filmiccurve_shoulder_tooltip">大於 1.0 時展開高光，小於 1.0 時壓縮高光。</string>
    <string name="fusion_fx_filmiccurve_filmiccurve_label">底片曲線</string>
    <string name="fusion_fx_filmiccurve_filmiccurve_tooltip">使用底片式對比曲線，加深陰影並展開高光，同時保留明暗兩端的層次。</string>
    <string name="fusion_fx_lensdistortion_distortion_label">畸變</string>
    <string name="fusion_fx_lensdistortion_distortion_tooltip">正值讓畫面向外鼓起，負值讓畫面向內收縮。</string>
    <string name="fusion_fx_lensdistortion_zoom_label">縮放</string>
    <string name="fusion_fx_lensdistortion_zoom_tooltip">縮放畫面，隱藏畸變後露出的邊緣。</string>
    <string name="fusion_fx_lensdistortion_lensdistortion_label">鏡頭畸變</string>
    <string name="fusion_fx_lensdistortion_lensdistortion_tooltip">產生桶形或枕形畸變，模擬廣角鏡頭效果。</string>
    <string name="fusion_fx_levels_inputblack_label">輸入黑點</string>
    <string name="fusion_fx_levels_inputblack_tooltip">對應為黑色的輸入亮度。調高可加深發灰的陰影。</string>
    <string name="fusion_fx_levels_inputwhite_label">輸入白點</string>
    <string name="fusion_fx_levels_outputblack_label">輸出黑點</string>
    <string name="fusion_fx_levels_outputblack_tooltip">提亮過暗的陰影，避免細節全部變成一片純黑。</string>
    <string name="fusion_fx_levels_outputwhite_label">輸出白點</string>
    <string name="fusion_fx_levels_levels_label">色階</string>
    <string name="fusion_fx_levels_levels_tooltip">調整黑點、白點、伽馬和輸出範圍，修正過暗或發灰的陰影。</string>
    <string name="fusion_fx_motionblur_length_label">長度</string>
    <string name="fusion_fx_motionblur_length_tooltip">拖影延伸的距離，以螢幕高度的百分比表示。</string>
    <string name="fusion_fx_motionblur_zoom_tooltip">拖影從螢幕中心向外放射，模擬快速前進的效果；中心保持清晰。</string>
    <string name="fusion_fx_motionblur_pan_label">平移</string>
    <string name="fusion_fx_motionblur_pan_tooltip">拖影沿固定方向延伸，模擬相機橫向掃過的效果。</string>
    <string name="fusion_fx_motionblur_angle_label">平移角度</string>
    <string name="fusion_fx_motionblur_angle_tooltip">掃動方向，單位為度。</string>
    <string name="fusion_fx_motionblur_spin_label">旋轉</string>
    <string name="fusion_fx_motionblur_spin_tooltip">拖影圍繞中心彎曲，模擬相機旋轉；負值表示反方向。</string>
    <string name="fusion_fx_motionblur_motionblur_label">運動模糊</string>
    <string name="fusion_fx_motionblur_motionblur_tooltip">模擬相機運動造成的模糊，讓畫面產生徑向、平移或旋轉拖影，同時保留中心的靜態細節。</string>
    <string name="fusion_fx_naturalcolors_luma_label">亮度曲線</string>
    <string name="fusion_fx_naturalcolors_luma_tooltip">在 YIQ 色彩空間中應用於亮度通道的伽馬。</string>
    <string name="fusion_fx_naturalcolors_chroma_label">色度增益</string>
    <string name="fusion_fx_naturalcolors_chroma_tooltip">增強兩個色差訊號通道的幅度。</string>
    <string name="fusion_fx_naturalcolors_naturalcolors_label">自然色彩</string>
    <string name="fusion_fx_naturalcolors_naturalcolors_tooltip">讓畫面更溫暖、飽和度更高，減少發灰感。移植自 PPSSPP 著色器。</string>
    <string name="fusion_fx_reflections_horizon_label">反射分界線</string>
    <string name="fusion_fx_reflections_horizon_tooltip">反射地面從螢幕哪個高度開始。分界線上方保持原樣。</string>
    <string name="fusion_fx_reflections_amount_tooltip">反射在地面上的可見強度。</string>
    <string name="fusion_fx_reflections_falloff_tooltip">地面靠近觀察者時，反射逐漸消失的速度。設為零時強度保持一致。</string>
    <string name="fusion_fx_reflections_perspective_label">透視</string>
    <string name="fusion_fx_reflections_perspective_tooltip">拉伸或壓縮鏡像。設為一時為真實鏡像，數值越大，鏡像越靠近分界線。</string>
    <string name="fusion_fx_reflections_ripple_label">波紋</string>
    <string name="fusion_fx_reflections_ripple_tooltip">擾動反射的波浪幅度。設為零時，鏡面完全靜止。</string>
    <string name="fusion_fx_reflections_ripplespeed_label">波紋速度</string>
    <string name="fusion_fx_reflections_ripplespeed_tooltip">波浪移動的速度。</string>
    <string name="fusion_fx_reflections_reflections_label">反射</string>
    <string name="fusion_fx_reflections_reflections_tooltip">在指定分界線下方建立地面鏡像，可加入水面波紋。</string>
    <string name="fusion_fx_scanlines_density_tooltip">螢幕中的掃描線對數。</string>
    <string name="fusion_fx_scanlines_intensity_tooltip">掃描線之間空隙的暗度。</string>
    <string name="fusion_fx_scanlines_tint_label">螢光色調</string>
    <string name="fusion_fx_scanlines_tint_tooltip">偏暖綠色螢光色調的強度。</string>
    <string name="fusion_fx_scanlines_scanlines_label">掃描線</string>
    <string name="fusion_fx_scanlines_scanlines_tooltip">交替壓暗畫素行，模擬映像管電視的水平掃描線。只需掃描線時，比完整映像管效果開銷更低。</string>
    <string name="fusion_fx_sharpen_sharpen_label">銳化</string>
    <string name="fusion_fx_sharpen_sharpen_tooltip">透過非銳化遮罩恢復縮放丟失的邊緣細節，尤其適合在低內部渲染解析度放大後使用。</string>
    <string name="fusion_fx_splittoning_shadowhue_label">陰影色相</string>
    <string name="fusion_fx_splittoning_shadowstrength_label">陰影強度</string>
    <string name="fusion_fx_splittoning_highlighthue_label">高光色相</string>
    <string name="fusion_fx_splittoning_highlightstrength_label">高光強度</string>
    <string name="fusion_fx_splittoning_balance_label">平衡</string>
    <string name="fusion_fx_splittoning_balance_tooltip">調整陰影與高光的分界位置。</string>
    <string name="fusion_fx_splittoning_splittoning_label">分離色調</string>
    <string name="fusion_fx_splittoning_splittoning_tooltip">分別為陰影和高光加入不同色相。</string>
    <string name="fusion_fx_vignette_strength_tooltip">螢幕角落變暗的程度。</string>
    <string name="fusion_fx_vignette_aspect_label">長寬比</string>
    <string name="fusion_fx_vignette_vignette_label">暗角</string>
    <string name="fusion_fx_vignette_vignette_tooltip">壓暗螢幕四角，將注意力引向中心，模擬相機鏡頭邊緣的亮度衰減。</string>
    <string name="fusion_fx_whitebalance_temperature_label">色溫</string>
    <string name="fusion_fx_whitebalance_temperature_tooltip">負值讓畫面偏藍、更冷；正值讓畫面偏橙、更暖。</string>
    <string name="fusion_fx_whitebalance_tint_label">色調</string>
    <string name="fusion_fx_whitebalance_tint_tooltip">負值偏綠，正值偏品紅。</string>
    <string name="fusion_fx_whitebalance_whitebalance_label">白平衡</string>
    <string name="fusion_fx_whitebalance_whitebalance_tooltip">修正畫面過冷、過暖或偏色。</string>
    <string name="fusion_fx_preset_anime_name">動漫</string>
    <string name="fusion_fx_preset_anime_description">賽璐璐風格：先淨化畫面，再將光照壓縮為平坦層級並加入墨線輪廓，最後疊加輕微光暈。</string>
    <string name="fusion_fx_preset_cinematic_name">電影</string>
    <string name="fusion_fx_preset_cinematic_description">底片風格：高光柔和泛光，搭配底片式對比曲線、冷色陰影與暖色高光，再加入細膩顆粒和輕微暗角。</string>
    <string name="fusion_fx_preset_clean_name">清晰</string>
    <string name="fusion_fx_preset_clean_description">改善較低的內部渲染解析度：消除抖動和壓縮噪點，平滑天空色帶，並恢復邊緣細節。不確定如何調整時，可從此預設開始。</string>
    <string name="fusion_fx_preset_dreamy_name">夢幻</string>
    <string name="fusion_fx_preset_dreamy_description">柔焦風格：中心保持清晰，周圍逐漸模糊，高光疊加大範圍光暈。適合節奏較慢的遊戲和過場動畫。</string>
    <string name="fusion_fx_preset_retro_name">復古</string>
    <string name="fusion_fx_preset_retro_description">老式電視風格：螢幕邊緣出現色彩分離，彎曲掃描線疊加螢光點陣，並壓暗四角。已關閉掃描線滾動，避免條帶爬動。</string>
    <string name="fusion_fx_preset_vivid_name">鮮豔</string>
    <string name="fusion_fx_preset_vivid_description">在保留原畫面風格的同時增強色彩：更暖、更飽和，擴展黑白範圍，並輕度銳化。</string>
</resources>
