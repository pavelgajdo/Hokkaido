    <string name="exefs_folder_no_main">所选文件夹及其子文件夹中未找到 exefs/main</string>
    <string name="frame_skip">跳帧</string>
    <string name="frame_skip_description">每绘制一帧后跳过的帧数。手机性能不足时，可通过减少画面帧数帮助游戏维持运行速度。0 表示不跳帧。</string>
    <string name="frames_ahead">提前准备下一帧</string>
    <string name="frames_ahead_auto">自动</string>
    <string name="frames_ahead_description">让 Switch 2 游戏在图形处理器绘制当前帧时准备下一帧。通常能提高速度，但部分游戏可能出现异常。“自动”会按游戏选择。</string>
    <string name="frames_ahead_off">关闭</string>
    <string name="frames_ahead_on">开启</string>
