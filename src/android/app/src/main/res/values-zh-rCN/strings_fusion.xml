    <string name="banana_another_game">另一个游戏</string>
    <string name="banana_checking">正在检查 %1$s…</string>
    <string name="banana_close_and_start">关闭并启动</string>
    <string name="banana_hide">隐藏</string>
    <string name="banana_later">稍后</string>
    <string name="banana_option_off">%1$s：关闭</string>
    <string name="banana_option_on">%1$s：开启</string>
    <string name="banana_option_ram_saver">节省内存</string>
    <string name="banana_option_ram_saver_description">将纹理数据保存在文件中，减少内存占用。在《时之笛》中可能导致地形缺失。</string>
    <string name="banana_option_ram_saver_strong">节省内存：增强</string>
    <string name="banana_option_ram_saver_strong_description">跳过最精细的两级纹理、缩小纹理缓存，并限制后台管线并发，进一步减少内存占用。包含普通节省内存模式的效果。</string>
    <string name="banana_option_soft_textures">降低纹理分辨率</string>
    <string name="banana_option_soft_textures_description">降低大型纹理的分辨率以节省内存。近距离观察时，纹理会更模糊。</string>
    <string name="banana_option_vegetation">完整植被</string>
    <string name="banana_option_vegetation_description">显示全部草地和植物。关闭后会减少植被数量，降低图形处理负担。</string>
    <string name="banana_options">Banana Native 选项</string>
    <string name="banana_options_description">为此游戏设置完整植被、内存节省和纹理分辨率。修改在下次启动游戏时生效。</string>
    <string name="banana_pack_import">导入 Banana Native 游戏包</string>
    <string name="banana_pack_import_description">导入独立版 Banana Native 已准备好的游戏包，避免重新准备。请先在 Banana Native 的游戏管理页面选择“导出游戏包”。</string>
    <string name="banana_pack_import_done">游戏包已导入</string>
    <string name="banana_pack_import_done_message">%1$s 现在可以通过 Banana Native 直接启动，无需重新准备。导出的游戏包不包含游玩时生成的着色器，这部分会在游玩时重新生成。</string>
    <string name="banana_pack_import_failed">游戏包导入失败</string>
    <string name="banana_pack_import_failed_message">未进行任何更改。%1$s</string>
    <string name="banana_pack_import_unavailable">此版本的 Hokkaido 未包含 Banana Native。</string>
    <string name="banana_pack_import_unreadable">无法读取所选文件。</string>
    <string name="banana_pack_import_working">正在复制并检查游戏包。较大的游戏包可能需要几分钟，请保持应用开启。</string>
    <string name="banana_pause">暂停</string>
    <string name="banana_play">开始游戏</string>
    <string name="banana_prepare">准备游戏</string>
    <string name="banana_prepare_title">准备 %1$s？</string>
    <string name="banana_preparing_title">正在准备 %1$s</string>
    <string name="banana_ready_description">游戏包已准备就绪，可以启动游戏。仍需编译的着色器会按当前设置处理。</string>
    <string name="banana_ready_title">%1$s 已准备就绪</string>
    <string name="banana_resume">继续</string>
    <string name="banana_resume_title">继续准备 %1$s？</string>
    <string name="banana_running_description">Banana Native 每次只能运行一个游戏。要关闭 %2$s 并启动 %1$s 吗？%2$s 中尚未保存的进度将丢失。</string>
    <string name="banana_running_title">%1$s 仍在运行</string>
    <string name="banana_shaders_build">立即编译全部着色器</string>
    <string name="banana_shaders_build_description">提前转换游戏的全部着色器，减少新场景中因着色器尚未生成而出现的白色画面或缺失物体。过程可能较长，建议连接充电器。</string>
    <string name="banana_try_anyway">仍然尝试</string>
    <string name="exefs_access_allow">允许</string>
    <string name="exefs_access_description">游戏文件夹中包含解包后的 Switch 2 游戏。Hokkaido 需要“所有文件访问权限”才能列出其中的 ExeFS 文件夹。</string>
    <string name="exefs_access_not_now">暂不允许</string>
    <string name="exefs_access_title">允许访问所有文件</string>
    <string name="exefs_folder_bad_path">无法获取所选文件夹的存储路径</string>
    <string name="exefs_folder_choose">选择要启动的 ExeFS</string>
    <string name="exefs_folder_needs_permission">请授予所有文件访问权限，然后重新选择文件夹</string>
    <string name="exefs_folder_no_main">所选文件夹及其子文件夹中未找到 exefs/main</string>
    <string name="frame_skip">跳帧</string>
    <string name="frame_skip_description">每绘制一帧后跳过的帧数。手机性能不足时，可通过减少画面帧数帮助游戏维持运行速度。0 表示不跳帧。</string>
    <string name="frames_ahead">提前准备下一帧</string>
    <string name="frames_ahead_auto">自动</string>
    <string name="frames_ahead_description">让 Switch 2 游戏在图形处理器绘制当前帧时准备下一帧。通常能提高速度，但部分游戏可能出现异常。“自动”会按游戏选择。</string>
    <string name="frames_ahead_off">关闭</string>
    <string name="frames_ahead_on">开启</string>
    <string name="game_engine">运行引擎</string>
    <string name="game_engine_auto">自动</string>
    <string name="game_engine_auto_now">自动（%1$s）</string>
    <string name="game_engine_banana_missing">Banana Native 启动失败</string>
    <string name="game_engine_banana_missing_description">此游戏已选择 Banana Native，但当前版本未包含该引擎，或引擎无法启动。是否改用 Hokkaido？</string>
    <string name="game_engine_description">选择此游戏使用的引擎。Hokkaido 模拟 Switch 2 的图形处理器；Banana Native 在手机上运行经过重编译的游戏代码，并通过 Vulkan 绘图，首次运行需要准备游戏。“自动”会按游戏选择引擎。</string>
    <string name="game_engine_emulate">Hokkaido</string>
    <string name="game_engine_native">Banana Native</string>
    <string name="game_engine_native_experimental">Banana Native（实验性）</string>
    <string name="game_engine_play_here">使用 Hokkaido 运行</string>
    <string name="launch_exefs_folder">启动 ExeFS 游戏文件夹</string>
    <string name="loader_error_memory">内存不足，无法启动游戏</string>
    <string name="loader_error_memory_description">Hokkaido 无法分配游戏所需的内存。请关闭其他应用以释放内存，然后重试。</string>
    <string name="oot_anti_aliasing">《时之笛》抗锯齿</string>
    <string name="oot_anti_aliasing_description">“不锐化”会跳过游戏中在手机上运行较慢的抗锯齿网络，直接显示没有强烈锐化的画面。</string>
    <string name="oot_anti_aliasing_game">游戏默认</string>
    <string name="oot_anti_aliasing_no_sharpening">不锐化</string>
    <string name="save_data_delete_failed">部分存档数据无法删除</string>
    <string name="scene_memory_cap">限制场景加载内存</string>
    <string name="scene_memory_cap_description">加载场景时将上传缓冲区限制在 256 MB，并逐帧释放较大的缓冲区。可缓解内存不足导致的游戏关闭，但可能降低持续加载纹理的游戏速度。“自动”仅对《时之笛》启用。</string>

