<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="fusion_fx_amdboost_scalefactor_label">缩放倍数</string>
    <string name="fusion_fx_amdboost_scalefactor_tooltip">超分辨率倍数（1.0 为原始尺寸，1.5 为 1.5 倍，2.0 为 2 倍）。数值越大，性能开销越高。</string>
    <string name="fusion_fx_amdboost_sharpness_label">锐度</string>
    <string name="fusion_fx_amdboost_sharpness_tooltip">RCAS 锐化强度。数值越大，边缘对比越强。</string>
    <string name="fusion_fx_amdboost_enabledenoise_label">启用降噪</string>
    <string name="fusion_fx_amdboost_enabledenoise_tooltip">在超分辨率前进行轻度降噪，减少画面瑕疵。</string>
    <string name="fusion_fx_amdboost_denoisestrength_label">降噪强度</string>
    <string name="fusion_fx_amdboost_denoisestrength_tooltip">降噪滤镜的强度，仅在启用降噪时生效。</string>
    <string name="fusion_fx_amdboost_enableupscaling_label">启用超分辨率</string>
    <string name="fusion_fx_amdboost_enableupscaling_tooltip">启用 FSR 1 EASU 超分辨率；关闭后仅进行锐化。</string>
    <string name="fusion_fx_amdboost_amdboost_label">AMD 增强</string>
    <string name="fusion_fx_amdboost_amdboost_tooltip">AMD FidelityFX 增强：结合 FSR 1 超分辨率（EASU）、RCAS 锐化和可选降噪，改善画质。</string>
    <string name="fusion_fx_bloom_radius_label">半径</string>
    <string name="fusion_fx_bloom_radius_tooltip">光晕从明亮区域向外扩散的范围。</string>
    <string name="fusion_fx_bloom_amount_label">强度</string>
    <string name="fusion_fx_bloom_amount_tooltip">叠加到画面上的光晕强度。</string>
    <string name="fusion_fx_bloom_bloom_label">泛光</string>
    <string name="fusion_fx_bloom_bloom_tooltip">让最亮的区域向外扩散出柔和光晕，模拟相机拍摄强光时的效果。</string>
    <string name="fusion_fx_blur_radius_tooltip">模糊扩散的距离，单位为像素。</string>
    <string name="fusion_fx_blur_strength_label">强度</string>
    <string name="fusion_fx_blur_strength_tooltip">原始画面与模糊画面的混合程度。</string>
    <string name="fusion_fx_blur_focussize_label">中心清晰区域</string>
    <string name="fusion_fx_blur_focussize_tooltip">屏幕中心保持清晰的范围。设为零时，整个画面均匀模糊。</string>
    <string name="fusion_fx_blur_focussoftness_label">焦点过渡</string>
    <string name="fusion_fx_blur_focussoftness_tooltip">中心清晰区域向周围模糊区域过渡的柔和程度。</string>
    <string name="fusion_fx_blur_blur_label">模糊</string>
    <string name="fusion_fx_blur_blur_tooltip">高斯模糊，可让中心保持清晰，用于柔化画面或模拟景深。</string>
    <string name="fusion_fx_crt_density_label">扫描线密度</string>
    <string name="fusion_fx_crt_rollspeed_label">滚动速度</string>
    <string name="fusion_fx_crt_rollspeed_tooltip">滚动条带的速度，设为零可关闭。</string>
    <string name="fusion_fx_crt_bleed_label">色彩溢出</string>
    <string name="fusion_fx_crt_bleed_tooltip">红色和绿色通道在水平方向上的分离距离。</string>
    <string name="fusion_fx_crt_crt_label">显像管电视</string>
    <string name="fusion_fx_crt_crt_tooltip">模拟显像管电视的弯曲扫描线与荧光点阵，适合原本为此类屏幕设计的游戏。</string>
    <string name="fusion_fx_cartoon_edgestrength_label">边缘强度</string>
    <string name="fusion_fx_cartoon_edgestrength_tooltip">检测到的边缘周围墨线的深浅。</string>
    <string name="fusion_fx_cartoon_levels_label">色彩层级</string>
    <string name="fusion_fx_cartoon_levels_tooltip">将颜色量化为多少个层级。</string>
    <string name="fusion_fx_cartoon_cartoon_label">卡通</string>
    <string name="fusion_fx_cartoon_cartoon_tooltip">添加墨线轮廓和平坦色块。忠实移植自 PPSSPP；暗处轮廓较重，若阴影糊成黑块，可尝试柔和卡通或赛璐璐着色。</string>
    <string name="fusion_fx_cartoonsoft_shadowguard_label">阴影保护</string>
    <string name="fusion_fx_cartoonsoft_shadowguard_tooltip">减弱暗处的轮廓。阴影变成黑块时可调高。</string>
    <string name="fusion_fx_cartoonsoft_smoothing_label">色阶化</string>
    <string name="fusion_fx_cartoonsoft_smoothing_tooltip">将画面转为平坦色块的程度。</string>
    <string name="fusion_fx_cartoonsoft_saturation_label">饱和度</string>
    <string name="fusion_fx_cartoonsoft_cartoonsoft_label">柔和卡通</string>
    <string name="fusion_fx_cartoonsoft_cartoonsoft_tooltip">添加墨线轮廓和平坦色块，同时减弱阴影中的轮廓，避免暗处糊成黑块。</string>
    <string name="fusion_fx_celshading_bands_label">明暗层级</string>
    <string name="fusion_fx_celshading_bands_tooltip">将光照压缩为多少个平坦层级。三至四级可形成经典卡通效果。</string>
    <string name="fusion_fx_celshading_bandcontrast_label">色阶对比</string>
    <string name="fusion_fx_celshading_bandcontrast_tooltip">让明暗层级更接近纯黑和纯白。阴影细节丢失时可调低。</string>
    <string name="fusion_fx_celshading_bandedge_label">色阶边界</string>
    <string name="fusion_fx_celshading_bandedge_tooltip">相邻明暗层级之间的过渡宽度。数值越小，赛璐璐分层越明显。</string>
    <string name="fusion_fx_celshading_detail_label">纹理细节</string>
    <string name="fusion_fx_celshading_detail_tooltip">平面化后保留的表面纹理细节。设为零时，色块完全平坦。</string>
    <string name="fusion_fx_celshading_outlinestrength_label">轮廓强度</string>
    <string name="fusion_fx_celshading_outlinestrength_tooltip">沿检测边缘绘制的墨线不透明度。</string>
    <string name="fusion_fx_celshading_outlinethreshold_label">轮廓阈值</string>
    <string name="fusion_fx_celshading_outlinethreshold_tooltip">边缘达到多强才会描线。调高可减少纹理和镜面高光上的墨线。</string>
    <string name="fusion_fx_celshading_saturation_tooltip">平坦色块区域的色彩浓度。</string>
    <string name="fusion_fx_celshading_celshading_label">赛璐璐着色</string>
    <string name="fusion_fx_celshading_celshading_tooltip">将光照压缩为少量清晰层级并描绘边缘，同时保留纹理细节和色相。</string>
    <string name="fusion_fx_chromaticaberration_strength_tooltip">屏幕边缘处的颜色通道分离距离，单位为像素。</string>
    <string name="fusion_fx_chromaticaberration_falloff_label">衰减</string>
    <string name="fusion_fx_chromaticaberration_falloff_tooltip">离开中心后通道分离增加的速度。数值越大，中心区域越干净。</string>
    <string name="fusion_fx_chromaticaberration_chromaticaberration_label">色差</string>
    <string name="fusion_fx_chromaticaberration_chromaticaberration_tooltip">让颜色通道越靠近屏幕边缘越分离，模拟镜头无法将所有颜色聚焦到同一点的现象。</string>
    <string name="fusion_fx_colorgrade_brightness_label">亮度</string>
    <string name="fusion_fx_colorgrade_contrast_label">对比度</string>
    <string name="fusion_fx_colorgrade_gamma_label">伽马</string>
    <string name="fusion_fx_colorgrade_colorgrade_label">基础调色</string>
    <string name="fusion_fx_colorgrade_colorgrade_tooltip">一次处理饱和度、亮度、对比度和伽马这四项基本色彩参数，可先从这里调整画面。</string>
    <string name="fusion_fx_deband_threshold_label">阈值</string>
    <string name="fusion_fx_deband_threshold_tooltip">周围区域多平坦才会被平滑处理。调高可消除更明显的色带，调低可保留更多细节。</string>
    <string name="fusion_fx_deband_radius_tooltip">采样范围，单位为像素。更宽的渐变需要更大的半径。</string>
    <string name="fusion_fx_deband_grain_label">抖动</string>
    <string name="fusion_fx_deband_grain_tooltip">平滑后添加少量噪点，打散残余色带。</string>
    <string name="fusion_fx_deband_deband_label">去色带</string>
    <string name="fusion_fx_deband_deband_tooltip">平滑天空等渐变中的明显分层，再用抖动消除残余色带。大面积平坦区域出现圈状色阶时可使用。</string>
    <string name="fusion_fx_denoise_curve_label">阴影偏置</string>
    <string name="fusion_fx_denoise_denoise_label">降噪</string>
    <string name="fusion_fx_denoise_denoise_tooltip">保留边缘的模糊处理，消除抖动和压缩噪点，同时保持轮廓清晰。移植自 Anime4K。</string>
    <string name="fusion_fx_filmgrain_intensity_label">强度</string>
    <string name="fusion_fx_filmgrain_size_label">大小</string>
    <string name="fusion_fx_filmgrain_size_tooltip">胶片颗粒的大小，单位为像素。</string>
    <string name="fusion_fx_filmgrain_colored_label">彩色程度</string>
    <string name="fusion_fx_filmgrain_colored_tooltip">设为零时为单色颗粒，设为一时各颜色通道分别生成噪点。</string>
    <string name="fusion_fx_filmgrain_filmgrain_label">胶片颗粒</string>
    <string name="fusion_fx_filmgrain_filmgrain_tooltip">添加摄影胶片颗粒，中间调最明显，黑色和白色区域逐渐减弱。</string>
    <string name="fusion_fx_filmiccurve_exposure_label">曝光</string>
    <string name="fusion_fx_filmiccurve_toe_label">暗部曲线</string>
    <string name="fusion_fx_filmiccurve_toe_tooltip">大于 1.0 时加深阴影，小于 1.0 时提亮阴影。</string>
    <string name="fusion_fx_filmiccurve_shoulder_label">亮部曲线</string>
    <string name="fusion_fx_filmiccurve_shoulder_tooltip">大于 1.0 时展开高光，小于 1.0 时压缩高光。</string>
    <string name="fusion_fx_filmiccurve_filmiccurve_label">胶片曲线</string>
    <string name="fusion_fx_filmiccurve_filmiccurve_tooltip">使用胶片式对比曲线，加深阴影并展开高光，同时保留明暗两端的层次。</string>
    <string name="fusion_fx_lensdistortion_distortion_label">畸变</string>
    <string name="fusion_fx_lensdistortion_distortion_tooltip">正值让画面向外鼓起，负值让画面向内收缩。</string>
    <string name="fusion_fx_lensdistortion_zoom_label">缩放</string>
    <string name="fusion_fx_lensdistortion_zoom_tooltip">缩放画面，隐藏畸变后露出的边缘。</string>
    <string name="fusion_fx_lensdistortion_lensdistortion_label">镜头畸变</string>
    <string name="fusion_fx_lensdistortion_lensdistortion_tooltip">产生桶形或枕形畸变，模拟广角镜头效果。</string>
    <string name="fusion_fx_levels_inputblack_label">输入黑点</string>
    <string name="fusion_fx_levels_inputblack_tooltip">映射为黑色的输入亮度。调高可加深发灰的阴影。</string>
    <string name="fusion_fx_levels_inputwhite_label">输入白点</string>
    <string name="fusion_fx_levels_outputblack_label">输出黑点</string>
    <string name="fusion_fx_levels_outputblack_tooltip">提亮过暗的阴影，避免细节全部变成一片纯黑。</string>
    <string name="fusion_fx_levels_outputwhite_label">输出白点</string>
    <string name="fusion_fx_levels_levels_label">色阶</string>
    <string name="fusion_fx_levels_levels_tooltip">调整黑点、白点、伽马和输出范围，修正过暗或发灰的阴影。</string>
    <string name="fusion_fx_motionblur_length_label">长度</string>
    <string name="fusion_fx_motionblur_length_tooltip">拖影延伸的距离，以屏幕高度的百分比表示。</string>
    <string name="fusion_fx_motionblur_zoom_tooltip">拖影从屏幕中心向外放射，模拟快速前进的效果；中心保持清晰。</string>
    <string name="fusion_fx_motionblur_pan_label">平移</string>
    <string name="fusion_fx_motionblur_pan_tooltip">拖影沿固定方向延伸，模拟相机横向扫过的效果。</string>
    <string name="fusion_fx_motionblur_angle_label">平移角度</string>
    <string name="fusion_fx_motionblur_angle_tooltip">扫动方向，单位为度。</string>
    <string name="fusion_fx_motionblur_spin_label">旋转</string>
    <string name="fusion_fx_motionblur_spin_tooltip">拖影围绕中心弯曲，模拟相机旋转；负值表示反方向。</string>
    <string name="fusion_fx_motionblur_motionblur_label">运动模糊</string>
    <string name="fusion_fx_motionblur_motionblur_tooltip">模拟相机运动造成的模糊，让画面产生径向、平移或旋转拖影，同时保留中心的静态细节。</string>
    <string name="fusion_fx_naturalcolors_luma_label">亮度曲线</string>
    <string name="fusion_fx_naturalcolors_luma_tooltip">在 YIQ 色彩空间中应用于亮度通道的伽马。</string>
    <string name="fusion_fx_naturalcolors_chroma_label">色度增益</string>
    <string name="fusion_fx_naturalcolors_chroma_tooltip">增强两个色差信号通道的幅度。</string>
    <string name="fusion_fx_naturalcolors_naturalcolors_label">自然色彩</string>
    <string name="fusion_fx_naturalcolors_naturalcolors_tooltip">让画面更温暖、饱和度更高，减少发灰感。移植自 PPSSPP 着色器。</string>
    <string name="fusion_fx_reflections_horizon_label">反射分界线</string>
    <string name="fusion_fx_reflections_horizon_tooltip">反射地面从屏幕哪个高度开始。分界线上方保持原样。</string>
    <string name="fusion_fx_reflections_amount_tooltip">反射在地面上的可见强度。</string>
    <string name="fusion_fx_reflections_falloff_tooltip">地面靠近观察者时，反射逐渐消失的速度。设为零时强度保持一致。</string>
    <string name="fusion_fx_reflections_perspective_label">透视</string>
    <string name="fusion_fx_reflections_perspective_tooltip">拉伸或压缩镜像。设为一时为真实镜像，数值越大，镜像越靠近分界线。</string>
    <string name="fusion_fx_reflections_ripple_label">波纹</string>
    <string name="fusion_fx_reflections_ripple_tooltip">扰动反射的波浪幅度。设为零时，镜面完全静止。</string>
    <string name="fusion_fx_reflections_ripplespeed_label">波纹速度</string>
    <string name="fusion_fx_reflections_ripplespeed_tooltip">波浪移动的速度。</string>
    <string name="fusion_fx_reflections_reflections_label">反射</string>
    <string name="fusion_fx_reflections_reflections_tooltip">在指定分界线下方创建地面镜像，可添加水面波纹。</string>
    <string name="fusion_fx_scanlines_density_tooltip">屏幕中的扫描线对数。</string>
    <string name="fusion_fx_scanlines_intensity_tooltip">扫描线之间空隙的暗度。</string>
    <string name="fusion_fx_scanlines_tint_label">荧光色调</string>
    <string name="fusion_fx_scanlines_tint_tooltip">偏暖绿色荧光色调的强度。</string>
    <string name="fusion_fx_scanlines_scanlines_label">扫描线</string>
    <string name="fusion_fx_scanlines_scanlines_tooltip">交替压暗像素行，模拟显像管电视的水平扫描线。只需扫描线时，比完整显像管效果开销更低。</string>
    <string name="fusion_fx_sharpen_sharpen_label">锐化</string>
    <string name="fusion_fx_sharpen_sharpen_tooltip">通过非锐化遮罩恢复缩放丢失的边缘细节，尤其适合在低内部渲染分辨率放大后使用。</string>
    <string name="fusion_fx_splittoning_shadowhue_label">阴影色相</string>
    <string name="fusion_fx_splittoning_shadowstrength_label">阴影强度</string>
    <string name="fusion_fx_splittoning_highlighthue_label">高光色相</string>
    <string name="fusion_fx_splittoning_highlightstrength_label">高光强度</string>
    <string name="fusion_fx_splittoning_balance_label">平衡</string>
    <string name="fusion_fx_splittoning_balance_tooltip">调整阴影与高光的分界位置。</string>
    <string name="fusion_fx_splittoning_splittoning_label">分离色调</string>
    <string name="fusion_fx_splittoning_splittoning_tooltip">分别为阴影和高光添加不同色相。</string>
    <string name="fusion_fx_vignette_strength_tooltip">屏幕角落变暗的程度。</string>
    <string name="fusion_fx_vignette_aspect_label">宽高比</string>
    <string name="fusion_fx_vignette_vignette_label">暗角</string>
    <string name="fusion_fx_vignette_vignette_tooltip">压暗屏幕四角，将注意力引向中心，模拟相机镜头边缘的亮度衰减。</string>
    <string name="fusion_fx_whitebalance_temperature_label">色温</string>
    <string name="fusion_fx_whitebalance_temperature_tooltip">负值让画面偏蓝、更冷；正值让画面偏橙、更暖。</string>
    <string name="fusion_fx_whitebalance_tint_label">色调</string>
    <string name="fusion_fx_whitebalance_tint_tooltip">负值偏绿，正值偏品红。</string>
    <string name="fusion_fx_whitebalance_whitebalance_label">白平衡</string>
    <string name="fusion_fx_whitebalance_whitebalance_tooltip">修正画面过冷、过暖或偏色。</string>
    <string name="fusion_fx_preset_anime_name">动漫</string>
    <string name="fusion_fx_preset_anime_description">赛璐璐风格：先净化画面，再将光照压缩为平坦层级并添加墨线轮廓，最后叠加轻微光晕。</string>
    <string name="fusion_fx_preset_cinematic_name">电影</string>
    <string name="fusion_fx_preset_cinematic_description">胶片风格：高光柔和泛光，搭配胶片式对比曲线、冷色阴影与暖色高光，再加入细腻颗粒和轻微暗角。</string>
    <string name="fusion_fx_preset_clean_name">清晰</string>
    <string name="fusion_fx_preset_clean_description">改善较低的内部渲染分辨率：消除抖动和压缩噪点，平滑天空色带，并恢复边缘细节。不确定如何调整时，可从此预设开始。</string>
    <string name="fusion_fx_preset_dreamy_name">梦幻</string>
    <string name="fusion_fx_preset_dreamy_description">柔焦风格：中心保持清晰，周围逐渐模糊，高光叠加大范围光晕。适合节奏较慢的游戏和过场动画。</string>
    <string name="fusion_fx_preset_retro_name">复古</string>
    <string name="fusion_fx_preset_retro_description">老式电视风格：屏幕边缘出现色彩分离，弯曲扫描线叠加荧光点阵，并压暗四角。已关闭扫描线滚动，避免条带爬动。</string>
    <string name="fusion_fx_preset_vivid_name">鲜艳</string>
    <string name="fusion_fx_preset_vivid_description">在保留原画面风格的同时增强色彩：更暖、更饱和，扩展黑白范围，并轻度锐化。</string>
</resources>
